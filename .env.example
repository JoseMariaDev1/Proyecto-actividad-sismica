# ==============================================================================
# VARIABLES DE ENTORNO - OBSERVATORIO DE ACTIVIDAD SÍSMICA
# Copia este archivo como .env y ajusta los valores si es necesario.
# NUNCA subas el archivo .env real con credenciales de producción al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL 16
# ------------------------------------------------------------------------------
POSTGRES_DB=sismos
POSTGRES_USER=sismo
POSTGRES_PASSWORD=sismo_secreto
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft mode)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=terremotos
KAFKA_TOPIC_REPLAY=terremotos-replay
KAFKA_CONSUMER_GROUP=observatorio-consumidor

# ------------------------------------------------------------------------------
# Extractor USGS
# ------------------------------------------------------------------------------
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_POLL_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# FastAPI & CORS
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Orígenes permitidos (separados por coma). Incluye localhost para desarrollo y comodín de Netlify.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://*.netlify.app
